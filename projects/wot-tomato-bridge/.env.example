# Copy these values into your own local environment or a local .env loader.
# Never commit a real Tomato.gg API key.
TOMATO_API_KEY=tmgg_replace_me
TOMATO_DEFAULT_SERVER=asia
TOMATO_DEFAULT_PLAYER_ID=

# Loopback-only bridge settings.
TOMATO_BRIDGE_HOST=127.0.0.1
TOMATO_BRIDGE_PORT=7342
TOMATO_BRIDGE_TIMEOUT_MS=12000
TOMATO_BRIDGE_MAX_RESPONSE_BYTES=2097152
TOMATO_BRIDGE_RATE_LIMIT=50
